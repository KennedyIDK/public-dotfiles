# Main Sway Config File

set $config_dir $HOME/.config/sway

# Include system-wide configs
include /etc/sway/config.d/*

# Defaults (Applications, Fonts, Menu, etc)
include $config_dir/defaults

# Input/Output
include $config_dir/keyboard
include $config_dir/keybinds
include $config_dir/mouse
include $config_dir/display

# Window Management
include $config_dir/windows

# System Management
include $config_dir/system

# System-specific settings/overrides
include $config_dir/spring-terrace

# Enable XWayland
xwayland enable

# Polkit
exec lxpolkit

# Status Bar
bar swaybar_command waybar

# Notifications
exec swaync

